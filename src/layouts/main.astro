---
import "../styles/global.css";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

interface Props {
    title?: string;
    description?: string;
    canonicalPath?: string;
    ogImage?: string;
    noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
    title = t("meta.title"),
    description = t("meta.description"),
    canonicalPath,
    ogImage = "/og-image.png",
    noindex = false,
} = Astro.props;

const site = "https://angelito91.github.io";

// Build canonical URL dynamically
const canonical = canonicalPath
    ? `${site}${canonicalPath}`
    : `${site}${Astro.url.pathname}`;

// Build og:url (same as canonical)
const ogUrl = canonical;

// Locale mapping
const localeMap: Record<string, string> = {
    es: "es_ES",
    en: "en_US",
    fr: "fr_FR",
};
const ogLocale = localeMap[lang] || "es_ES";

// Absolute OG image URL
const ogImageAbsolute = ogImage.startsWith("http")
    ? ogImage
    : `${site}${ogImage}`;

// JSON-LD structured data
const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "ProfilePage",
            "@id": `${canonical}#profile`,
            url: canonical,
            name: title,
            description,
            inLanguage: lang,
            mainEntity: { "@id": `${site}/#person` },
        },
        {
            "@type": "Person",
            "@id": `${site}/#person`,
            name: "Angel Alberto Portuondo Hierrezuelo",
            alternateName: "Angel Portuondo",
            url: site,
            image: `${site}/og-image.png`,
            jobTitle: lang === "es" ? "Desarrollador Full Stack y de videojuegos" : "Full Stack and game developer",
            description: t("meta.description"),
            address: { "@type": "PostalAddress", addressLocality: "Santiago de Cuba", addressCountry: "CU" },
            alumniOf: { "@type": "CollegeOrUniversity", name: "Universidad de Oriente", url: "https://www.uo.edu.cu/" },
            worksFor: { "@type": "Organization", name: "QvaLabs", url: "https://qvalabs.com" },
            sameAs: ["https://github.com/Angelito91", "https://linkedin.com/in/angelito91"],
        },
        {
            "@type": "WebSite",
            "@id": `${site}/#website`,
            name: "Angel Portuondo",
            url: site,
            description: t("meta.description"),
            inLanguage: lang,
        },
    ],
};
---

<html lang={lang}>
    <head>
        <script is:inline>document.documentElement.classList.add("js")</script>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- SEO -->
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="author" content="Angel Alberto Portuondo Hierrezuelo" />
        <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />

        <!-- Open Graph -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={ogUrl} />
        <meta property="og:locale" content={ogLocale} />
        <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
        <meta property="og:image" content={ogImageAbsolute} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:site_name" content="Angel Portuondo" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageAbsolute} />
        <meta name="twitter:creator" content="@Angelito23756" />

        <!-- Alternate languages -->
        <link rel="alternate" hreflang="es" href={`${site}/`} />
        <link rel="alternate" hreflang="en" href={`${site}/en/`} />
        <link rel="alternate" hreflang="x-default" href={`${site}/`} />

        <!-- Canonical -->
        <link rel="canonical" href={canonical} />

        <!-- Favicon -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Editorial type system -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap"
            rel="stylesheet"
        />

        <!-- Theme color -->
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f6f2" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#17171c" />

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    </head>

    <body class="grain-overlay">
        <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:text-primary-foreground">{lang === "es" ? "Saltar al contenido" : "Skip to content"}</a>
        <div class="min-h-screen relative">
            <div class="flicker-top" aria-hidden="true"><canvas id="flicker-grid"></canvas></div>
            <slot />
        </div>

        <!-- ═══ Global Scripts ═══ -->
        <script>
            // ── Scroll Reveal Observer ──
            // Pre-dispara 120px antes de entrar al viewport para que el fade
            // termine cuando el usuario llega al contenido (sin parpadeos).
            const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            function revealElement(el: Element) {
                el.classList.add("revealed");
                el.addEventListener("animationend", () => el.classList.add("reveal-done"), { once: true });
            }

            function initRevealObserver() {
                const revealElements = document.querySelectorAll(
                    ".reveal, .reveal-left, .reveal-right, .reveal-scale, .blur-fade",
                );
                if (reduceMotion || !("IntersectionObserver" in window)) {
                    revealElements.forEach(revealElement);
                    return;
                }
                const revealObserver = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (entry.isIntersecting) {
                                revealElement(entry.target);
                                revealObserver.unobserve(entry.target);
                            }
                        });
                    },
                    {
                        threshold: 0.1,
                        rootMargin: "0px 0px 120px 0px",
                    },
                );
                revealElements.forEach((el) => {
                    if (!el.classList.contains("revealed")) revealObserver.observe(el);
                });
            }

            initRevealObserver();
            document.addEventListener("astro:after-swap", initRevealObserver);

            // ── Flickering grid: patron superior como en references ──
            // Rejilla de cuadros de 2px que parpadean (canvas, color del tema).
            (function initFlickerGrid() {
                const canvasEl = document.getElementById("flicker-grid");
                if (!(canvasEl instanceof HTMLCanvasElement)) return;
                const canvas: HTMLCanvasElement = canvasEl;
                const container = canvas.parentElement as HTMLElement;
                const ctx = canvas.getContext("2d");
                if (!ctx) return;
                const SQUARE = 2, GAP = 2, MAX_OP = 0.3, CHANCE = 0.3;
                const reduceFlicker = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                let fg = "0, 0, 0";
                function resolveFg() {
                    const tmp = document.createElement("div");
                    tmp.style.color = "var(--foreground)";
                    tmp.style.position = "absolute";
                    tmp.style.visibility = "hidden";
                    document.body.appendChild(tmp);
                    const computed = window.getComputedStyle(tmp).color;
                    document.body.removeChild(tmp);
                    // Convierte cualquier espacio de color (oklch, etc.) a rgb
                    // pintando 1px en un canvas temporal.
                    const tiny = document.createElement("canvas");
                    tiny.width = tiny.height = 1;
                    const tctx = tiny.getContext("2d");
                    if (!tctx) return;
                    tctx.fillStyle = computed;
                    tctx.fillRect(0, 0, 1, 1);
                    const [r, g, b] = Array.from(tctx.getImageData(0, 0, 1, 1).data);
                    fg = `${r}, ${g}, ${b}`;
                }
                resolveFg();
                new MutationObserver(resolveFg).observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
                let cols = 0, rows = 0, dpr = 1, raf = 0, visible = true, last = 0;
                let squares = new Float32Array(0);
                function draw() {
                    ctx?.clearRect(0, 0, canvas.width, canvas.height);
                    if (!ctx) return;
                    for (let i = 0; i < cols; i++) {
                        for (let j = 0; j < rows; j++) {
                            ctx.fillStyle = `rgba(${fg},${squares[i * rows + j].toFixed(3)})`;
                            ctx.fillRect(i * (SQUARE + GAP) * dpr, j * (SQUARE + GAP) * dpr, SQUARE * dpr, SQUARE * dpr);
                        }
                    }
                }
                function setup() {
                    const w = container.clientWidth, h = container.clientHeight;
                    dpr = window.devicePixelRatio || 1;
                    canvas.width = w * dpr;
                    canvas.height = h * dpr;
                    cols = Math.floor(w / (SQUARE + GAP));
                    rows = Math.floor(h / (SQUARE + GAP));
                    squares = new Float32Array(cols * rows);
                    for (let i = 0; i < squares.length; i++) squares[i] = Math.random() * MAX_OP;
                    draw();
                }
                function tick(t: number) {
                    if (!visible) return;
                    const dt = (t - last) / 1000;
                    last = t;
                    for (let i = 0; i < squares.length; i++) {
                        if (Math.random() < CHANCE * dt) squares[i] = Math.random() * MAX_OP;
                    }
                    draw();
                    raf = requestAnimationFrame(tick);
                }
                function start() {
                    cancelAnimationFrame(raf);
                    last = performance.now();
                    if (!reduceFlicker && visible) raf = requestAnimationFrame(tick);
                }
                new IntersectionObserver(
                    ([entry]) => {
                        visible = entry.isIntersecting;
                        if (visible) start();
                        else cancelAnimationFrame(raf);
                    },
                    { threshold: 0 },
                ).observe(canvas);
                new ResizeObserver(setup).observe(container);
                setup();
                start();
            })();

            // ── Smooth Scroll for anchor links ──
            document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
                anchor.addEventListener("click", (e) => {
                    const href = (anchor as HTMLAnchorElement).getAttribute(
                        "href",
                    );
                    if (!href || href === "#") return;

                    const target = document.querySelector(href);
                    if (target) {
                        e.preventDefault();
                        target.scrollIntoView({
                            behavior: "smooth",
                            block: "start",
                        });
                        history.pushState(null, "", href);
                    }
                });
            });

            // ── Mouse position tracker for gradient glow ──
            let rafId: number | null = null;
            document.addEventListener("mousemove", (e) => {
                if (rafId) return;
                rafId = requestAnimationFrame(() => {
                    document.documentElement.style.setProperty(
                        "--mouse-x",
                        `${e.clientX}px`,
                    );
                    document.documentElement.style.setProperty(
                        "--mouse-y",
                        `${e.clientY}px`,
                    );
                    rafId = null;
                });
            });
        </script>
    </body>
</html>
