---
interface Props {
    className?: string;
}

const { className = "" } = Astro.props;
---

<a href="#inicio" class:list={["group flex items-center gap-3", className]}>
    <span class="grid size-9 place-items-center rounded-full bg-[var(--ink)] text-sm font-bold text-white transition-transform duration-300 group-hover:-rotate-6">A</span>
    <span class="font-mono text-sm font-semibold tracking-[-0.04em] text-[var(--ink)]">angelito<span class="text-[var(--accent)]">91</span></span>
</a>
