---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import CVDownloadButton from "@/components/CVDownloadButton.astro";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="sobre-mi">
    <div class="flex min-h-0 flex-col gap-y-4">
        <h2 class="blur-fade text-xl font-bold" style="--delay:120ms">{t("about.title")}</h2>
        <div class="blur-fade prose max-w-full text-pretty font-sans leading-relaxed text-muted-foreground dark:prose-invert" style="--delay:160ms">
            {lang === "es" ? (
                <>
                    <p class="max-w-[68ch] text-pretty">Más de 2 años de experiencia como <strong class="key-term">Desarrollador Full Stack</strong>. En <strong class="key-term">Xitry Games</strong> trabajé con <strong class="key-term">Unreal Engine</strong> creando herramientas, gameplay y la web oficial del estudio. He construido soluciones frontend y backend combinando diseño, rendimiento y funcionalidad. Actualmente estudio <strong class="key-term">Ciencias de la Computación</strong> en la <strong class="key-term">Universidad de Oriente</strong>.</p>
                    <p class="max-w-[68ch] text-pretty">Como <strong class="key-term">fundador de QvaLabs</strong>, participo en el diseño, desarrollo y despliegue de productos digitales: sitios web, blogs, automatización, IA e infraestructura. Me gusta entender el problema completo y construir <strong class="key-term">software mantenible</strong> que pueda crecer con cada proyecto.</p>
                </>
            ) : (
                <>
                    <p class="max-w-[68ch] text-pretty">More than 2 years of experience as a <strong class="key-term">Full Stack Developer</strong>. At <strong class="key-term">Xitry Games</strong>, I worked with <strong class="key-term">Unreal Engine</strong> on tools, gameplay, and the studio's official website. I build frontend and backend solutions that combine design, performance, and functionality. I am currently studying <strong class="key-term">Computer Science</strong> at <strong class="key-term">Universidad de Oriente</strong>.</p>
                    <p class="max-w-[68ch] text-pretty">As the <strong class="key-term">founder of QvaLabs</strong>, I design, build, and deploy digital products including websites, blogs, automation, AI, and infrastructure. I enjoy understanding the full problem and creating <strong class="key-term">maintainable software</strong> that can grow with every project.</p>
                </>
            )}
        </div>
        <div class="blur-fade" style="--delay:200ms">
            <CVDownloadButton variant="about" />
        </div>
    </div>
</section>
