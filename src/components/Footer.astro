---
import { getLangFromUrl } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
---

<footer class="site-shell border-t pb-28 pt-8 text-center text-xs text-muted-foreground">
    <p>{lang === "es" ? "Construido con Astro, Tailwind CSS y mucho código." : "Built with Astro, Tailwind CSS, and lots of code."}</p>
</footer>
