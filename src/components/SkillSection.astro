---
import { getLangFromUrl } from "@/i18n/utils";
import { Icon } from "astro-icon/components";
const lang = getLangFromUrl(Astro.url);
// Iconos locales desde svgl.app (src/icons/). Los monocromaticos usan
// currentColor y se adaptan al tema claro/oscuro.
const skills = [
    ["Astro", "astro"],
    ["TypeScript", "typescript"],
    ["React", "react"],
    ["Svelte", "svelte"],
    ["Tailwind CSS", "tailwindcss"],
    ["Cloudflare", "cloudflare"],
    ["Node.js", "nodejs"],
    ["Python", "python"],
    ["Rust", "rust"],
    ["C++", "cplusplus"],
    ["Unreal Engine", "unrealengine"],
    ["Godot", "godot"],
    ["Git", "git"],
    ["Linux", "linux"],
    ["Bun", "bun"],
    ["OpenCode", "opencode"],
    ["Codex", "codex"],
    ["Claude", "claude"],
];
---

<section id="habilidades">
    <div class="flex min-h-0 flex-col gap-y-4">
        <h2 class="blur-fade text-xl font-bold" style="--delay:380ms">{lang === "es" ? "Habilidades" : "Skills"}</h2>
        <div class="flex flex-wrap gap-2">
            {skills.map(([skill, icon], index) => <span class="blur-fade tech-pill" style={`--delay:${420 + index * 25}ms`}><Icon name={icon} size={17} /><span>{skill}</span></span>)}
        </div>
    </div>
</section>
