---
import { getLangFromUrl, getAlternateLanguages } from "@/i18n/utils";
import { Github, Linkedin, Mail, Moon, Sun } from "lucide-astro";
const lang = getLangFromUrl(Astro.url);
const alternates = getAlternateLanguages(Astro.url.pathname, lang);
const socials = [
    { label: "GitHub", href: "https://github.com/Angelito91", icon: "github" },
    { label: "LinkedIn", href: "https://linkedin.com/in/angelito91", icon: "linkedin" },
    { label: "Email", href: "mailto:portuondoangel@gmail.com", icon: "mail" },
];
---

<div class="pointer-events-none fixed inset-x-0 bottom-4 z-30">
    <nav class="dock pointer-events-auto mx-auto flex h-14 w-fit items-end justify-center gap-2 rounded-full border bg-card/90 p-2 shadow-[0_0_10px_3px] shadow-primary/5 backdrop-blur-3xl" aria-label="Portfolio navigation">
        {socials.map((social) => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="dock-link dock-item" aria-label={social.label} title={social.label}>
                {social.icon === "github" && <Github size={16} strokeWidth={1.8} />}
                {social.icon === "linkedin" && <Linkedin size={16} strokeWidth={1.8} />}
                {social.icon === "mail" && <Mail size={16} strokeWidth={1.8} />}
            </a>
        ))}
        <span class="mx-1 h-7 w-px self-center bg-border" aria-hidden="true"></span>
        <div class="flex items-center gap-1" role="group" aria-label="Idioma / Language">
            {[
                { code: "es", label: "Español" },
                { code: "en", label: "English" },
            ].map((item) => {
                const active = item.code === lang;
                const alternate = alternates.find((entry) => entry.lang === item.code);
                const flag = item.code === "es" ? (
                    <svg viewBox="0 0 20 14" class="h-3.5 w-5 overflow-hidden rounded-[3px] ring-1 ring-border" aria-hidden="true"><rect width="20" height="14" fill="#AA151B" /><rect y="3.5" width="20" height="7" fill="#F1BF00" /></svg>
                ) : (
                    <svg viewBox="0 0 20 14" class="h-3.5 w-5 overflow-hidden rounded-[3px] ring-1 ring-border" aria-hidden="true"><rect width="20" height="14" fill="#fff" /><g fill="#B31942"><rect y="0" width="20" height="1.08" /><rect y="2.15" width="20" height="1.08" /><rect y="4.31" width="20" height="1.08" /><rect y="6.46" width="20" height="1.08" /><rect y="8.62" width="20" height="1.08" /><rect y="10.77" width="20" height="1.08" /><rect y="12.92" width="20" height="1.08" /></g><rect width="8" height="7.54" fill="#3C3B6E" /><g fill="#fff"><circle cx="1.3" cy="1.3" r="0.55" /><circle cx="4" cy="1.3" r="0.55" /><circle cx="6.7" cy="1.3" r="0.55" /><circle cx="2.65" cy="3.2" r="0.55" /><circle cx="5.35" cy="3.2" r="0.55" /><circle cx="1.3" cy="5.1" r="0.55" /><circle cx="4" cy="5.1" r="0.55" /><circle cx="6.7" cy="5.1" r="0.55" /></g></svg>
                );
                if (active) return <span aria-current="true" aria-label={item.label} title={item.label} class="grid size-10 place-items-center rounded-3xl border border-foreground bg-muted">{flag}</span>;
                return <a href={alternate?.href || "/"} aria-label={item.label} title={item.label} class="grid size-10 place-items-center rounded-3xl border border-border text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">{flag}</a>;
            })}
        </div>
        <button id="theme-toggle" class="dock-link dock-item" type="button" aria-label="Cambiar tema" title="Cambiar tema"><span class="dark:hidden"><Moon size={16} strokeWidth={1.8} /></span><span class="hidden dark:inline"><Sun size={16} strokeWidth={1.8} /></span></button>
    </nav>
</div>

<script>
    const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
    themeToggle?.addEventListener("click", () => {
        document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", document.documentElement.classList.contains("dark") ? "dark" : "light");
    });
    if (localStorage.getItem("theme") === "dark") document.documentElement.classList.add("dark");

    const dock = document.querySelector<HTMLElement>("nav");
    const dockItems = [...document.querySelectorAll<HTMLElement>(".dock-item")];
    dock?.addEventListener("pointermove", (event) => {
        const pointer = event.pageX;
        dockItems.forEach((item) => {
            const distance = Math.abs(pointer - (item.getBoundingClientRect().left + item.offsetWidth / 2));
            const size = Math.max(40, 60 - distance * 0.2);
            item.style.setProperty("--dock-size", `${size.toFixed(1)}px`);
            item.style.setProperty("--dock-icon-size", `${(size * 0.5).toFixed(1)}px`);
        });
    });
    dock?.addEventListener("pointerleave", () => dockItems.forEach((item) => {
        item.style.setProperty("--dock-size", "40px");
        item.style.setProperty("--dock-icon-size", "20px");
    }));
</script>
