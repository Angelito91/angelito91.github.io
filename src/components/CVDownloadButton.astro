---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
interface Props { variant?: "desktop" | "mobile" | "about"; }
const { variant = "desktop" } = Astro.props;
const cvLink = lang === "es" ? t("cv.es") : t("cv.en");
---

<a
    href={cvLink}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
        "inline-flex items-center justify-center gap-2 border border-[var(--ink)] bg-[var(--ink)] px-4 py-2 font-mono text-xs font-semibold uppercase tracking-[0.08em] text-white transition duration-300 hover:bg-[var(--accent)] hover:border-[var(--accent)]",
        { "hidden md:inline-flex": variant === "desktop", "md:hidden": variant === "mobile", "px-5 py-3": variant === "about" },
    ]}
>
    {t("nav.resume")}
    <span aria-hidden="true">↗</span>
</a>
