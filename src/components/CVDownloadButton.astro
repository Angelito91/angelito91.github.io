---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
interface Props { variant?: "desktop" | "mobile" | "about"; }
const { variant = "desktop" } = Astro.props;
const cvLink = lang === "es" ? t("cv.es") : t("cv.en");
---

<a
    href={cvLink}
    target="_blank"
    rel="noopener noreferrer"
    class:list={[
        "inline-flex items-center justify-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2",
        { "hidden md:inline-flex": variant === "desktop", "md:hidden": variant === "mobile" },
    ]}
>
    {t("nav.resume")}
    <span aria-hidden="true">↗</span>
</a>
