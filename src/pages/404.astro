---
import Layout from "@/layouts/main.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { ArrowLeft } from "lucide-astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
    title={`${t("404.title")} — Angel Portuondo`}
    description={t("404.description")}
    canonicalPath="/404/"
    noindex={true}
>
    <main id="main" class="site-shell flex min-h-dvh flex-col items-center justify-center py-28 text-center">
        <div class="blur-fade section-label" style="--delay:40ms">Error 404</div>
        <p class="blur-fade mt-6 text-7xl font-bold tracking-tighter sm:text-8xl" style="--delay:80ms" aria-hidden="true">404</p>
        <h1 class="blur-fade mt-4 text-balance text-2xl font-bold tracking-tight sm:text-3xl" style="--delay:120ms">{t("404.title")}</h1>
        <p class="blur-fade mt-3 max-w-[52ch] text-pretty text-muted-foreground" style="--delay:160ms">{t("404.description")}</p>
        <a
            href={lang === "es" ? "/" : `/${lang}/`}
            class="blur-fade mt-8 inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            style="--delay:200ms"
        >
            <ArrowLeft size={16} />{t("404.back")}
        </a>
        <p class="blur-fade mt-10 text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground" style="--delay:240ms">{t("404.label")}</p>
    </main>
</Layout>
